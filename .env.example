# =========================================================================
# Lumina LMS V3 — Root Environment Schema Template
# 6th Civilians Corporation
#
# Reference schema for containerized Docker Compose and production environments.
# Full documentation: server/.env.example
# =========================================================================

NODE_ENV=production
PORT=5000
BODY_SIZE_LIMIT=10mb

# MongoDB Atlas
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/lumina_production?retryWrites=true&w=majority

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://portal.yourcompany.com,https://trainer.yourcompany.com,https://admin.yourcompany.com

# Redis Bus (used for Socket.io adapter AND distributed rate limiting)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Or unified connection string:
# REDIS_URL=redis://:password@host:6379/0

# Piston Isolated Sandbox
PISTON_WORKERS=http://piston1:2000,http://piston2:2000

# Code Lab Limits (server enforces maximums — client cannot override)
CODE_EXECUTION_TIMEOUT=6000
CODE_EXECUTION_MAX_TIMEOUT=10000
CODE_QUEUE_CONCURRENCY=5
CODE_QUEUE_MAX_PENDING=300
CODE_QUEUE_WAIT_MS=20000

# Rate Limiting (tune after load testing)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_2FA_MAX=5
RATE_LIMIT_2FA_WINDOW_MS=900000
RATE_LIMIT_RESET_MAX=5
RATE_LIMIT_RESET_WINDOW_MS=3600000

# Backblaze B2 Object Storage
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_APPLICATION_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_secret_key
B2_BUCKET_NAME=lumina-enterprise-storage
B2_REGION=us-west-004

# JWT
JWT_SECRET=replace_with_secure_production_secret
JWT_EXPIRATION=7d
COOKIE_DOMAIN=.yourcompany.com
SENTRY_DSN=
