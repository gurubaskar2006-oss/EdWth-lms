# =========================================================================
# Lumina LMS V3 — Production Environment Configuration Template
# 6th Civilians Corporation
#
# IMPORTANT SECURITY NOTICE:
# This file is a configuration schema and reference template.
# DO NOT commit real secrets, private keys, or credentials to version control.
# In production, inject secrets via Hetzner Vault, Doppler, or GitHub Secrets.
# =========================================================================

# --- Application Server ---
NODE_ENV=production
PORT=5000
APP_NAME="Lumina LMS Enterprise"
APP_URL=https://lumina.yourcompany.com
BODY_SIZE_LIMIT=10mb

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# Merged with localhost origins (always allowed in development).
ALLOWED_ORIGINS=https://portal.yourcompany.com,https://trainer.yourcompany.com,https://admin.yourcompany.com

# --- Primary Database (MongoDB Atlas) ---
# Multi-tenant partitioned replica set connection string.
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/lumina_production?retryWrites=true&w=majority&appName=LuminaCluster

# --- Coordination & Real-Time Bus (Redis 7) ---
# Coordinates Socket.io multi-node events via @socket.io/redis-adapter.
# Also used for distributed rate limiting (fail-closed on critical endpoints).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Or unified connection string:
# REDIS_URL=redis://:strong_redis_password@redis-cluster.internal:6379/0

# --- Authentication & Session Security ---
# High-entropy random 256-bit secret for signing JSON Web Tokens.
JWT_SECRET=generate_strong_64_char_random_hex_secret_here
JWT_EXPIRATION=7d
COOKIE_DOMAIN=.yourcompany.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# --- Isolated Code Lab Sandbox (Piston Service) ---
# Multi-worker container pool endpoints for untrusted code execution.
# Production FAILS CLOSED (HTTP 503) if these workers are unreachable.
PISTON_URL=http://127.0.0.1:2000
PISTON_WORKERS=http://piston1:2000,http://piston2:2000

# --- Code Lab Execution Limits (server-side, client cannot override) ---
# Tune these based on load testing. Never expose to client.
CODE_EXECUTION_TIMEOUT=6000         # Default execution timeout (ms)
CODE_EXECUTION_MAX_TIMEOUT=10000    # Absolute maximum timeout (ms) — client cannot exceed this
CODE_EXECUTION_OUTPUT_LIMIT=102400  # Maximum output bytes (100 KB)
CODE_EXECUTION_MEMORY=134217728     # Memory limit per container (128 MB in bytes)
CODE_QUEUE_CONCURRENCY=5            # Max concurrent executions
CODE_QUEUE_MAX_PENDING=300          # Max jobs waiting in queue before 429/503
CODE_QUEUE_WAIT_MS=20000            # Max wait time in queue (ms) before timeout

# --- Rate Limiting (configurable, tune after load testing) ---
# All limits are per-user-ID (authenticated) or per-IP (unauthenticated).
# Security-sensitive endpoints FAIL CLOSED when Redis is unavailable in production.
RATE_LIMIT_LOGIN_MAX=10             # max login attempts
RATE_LIMIT_LOGIN_WINDOW_MS=900000   # per 15 minutes
RATE_LIMIT_2FA_MAX=5                # max 2FA attempts
RATE_LIMIT_2FA_WINDOW_MS=900000     # per 15 minutes
RATE_LIMIT_RESET_MAX=5              # max password reset attempts
RATE_LIMIT_RESET_WINDOW_MS=3600000  # per 1 hour
RATE_LIMIT_CODE_MAX=60              # max code executions
RATE_LIMIT_CODE_WINDOW_MS=60000     # per 1 minute
RATE_LIMIT_UPLOAD_MAX=20            # max file uploads
RATE_LIMIT_UPLOAD_WINDOW_MS=60000   # per 1 minute
RATE_LIMIT_ADMIN_MAX=200            # max admin endpoint requests
RATE_LIMIT_ADMIN_WINDOW_MS=60000    # per 1 minute
RATE_LIMIT_GENERAL_MAX=300          # max general API requests
RATE_LIMIT_GENERAL_WINDOW_MS=60000  # per 1 minute

# --- Object Storage (Backblaze B2 S3-Compatible API) ---
# Strictly used for persistent storage of attachments, syllabus files, and export archives.
# Edge traffic and TLS termination are managed separately by Hetzner Load Balancer.
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_APPLICATION_KEY_ID=your_b2_application_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=lumina-enterprise-storage
B2_REGION=us-west-004

# --- Observability & Telemetry ---
SENTRY_DSN=https://<public_key>@o<organization_id>.ingest.sentry.io/<project_id>
LOG_LEVEL=info
